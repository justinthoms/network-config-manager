<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<title>Network Config Manager</title>
<style>
:root{
  --bg:#f2f4f9;--surface:#fff;--surface2:#f8fafc;--border:#e3e7ee;
  --text:#101728;--muted:#66708a;--primary:#3556d9;--primary2:#2942b3;--primary-soft:#eef1fd;
  --success:#12875a;--success-soft:#e8f8ef;--warning:#b7691a;--warning-soft:#fdf3e6;
  --danger:#c2373a;--danger-soft:#fbeded;--info:#2563eb;--info-soft:#eaf1ff;
  --dark:#0c1224;--dark2:#151d34;
  --shadow:0 1px 2px rgba(16,23,40,.04),0 8px 24px rgba(16,23,40,.06);
  --shadow-sm:0 1px 2px rgba(16,23,40,.05);
  --radius:16px;--radius-sm:10px
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:"Inter",ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased}
button,input,select{font:inherit}button{cursor:pointer}
.hidden{display:none!important}
svg{display:block}
.icon{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.icon-lg{width:20px;height:20px}

/* ---------- header ---------- */
.app-header{height:64px;background:linear-gradient(180deg,var(--dark2),var(--dark));color:#fff;border-bottom:1px solid #202a45;position:sticky;top:0;z-index:20}
.header-inner{height:100%;max-width:1480px;margin:auto;padding:0 26px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px}
.brand-mark{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#5b7cf0,#3556d9);display:grid;place-items:center;box-shadow:0 4px 14px rgba(53,86,217,.4)}
.brand-mark svg{width:20px;height:20px;stroke:#fff}
.brand h1{font-size:15.5px;margin:0;font-weight:700;letter-spacing:-.1px}
.brand small{color:#8b96b8;font-size:11px;font-weight:500}
.header-right{display:flex;align-items:center;gap:16px}
.user-pill{font-size:12.5px;color:#c4cbe0;display:flex;align-items:center;gap:7px;font-weight:500}
.user-avatar{width:24px;height:24px;border-radius:50%;background:#28345a;display:grid;place-items:center;font-size:10.5px;font-weight:700;color:#aebbe6}
.status-pill{display:flex;align-items:center;gap:7px;font-size:11.5px;color:#9aa5c4;font-weight:600}
.dot{width:7px;height:7px;border-radius:50%;background:#64748b}.dot.online{background:#2fd07f;box-shadow:0 0 0 4px rgba(47,208,127,.18)}
.logout-btn{display:flex;align-items:center;gap:6px;color:#dbe1f5;border-color:#2a3454;background:#161f3a}
.logout-btn:hover{background:#1b2646}

/* ---------- shell / nav ---------- */
.shell{max-width:1480px;margin:auto;display:grid;grid-template-columns:224px minmax(0,1fr);min-height:calc(100vh - 64px)}
.sidebar{background:#fff;border-right:1px solid var(--border);padding:22px 14px}
.nav-label{font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:#9aa3ba;font-weight:750;padding:6px 12px 10px}
.nav-btn{width:100%;height:40px;border:0;background:transparent;border-radius:9px;color:#4b5573;text-align:left;padding:0 11px;display:flex;align-items:center;gap:11px;font-size:13px;font-weight:600;margin:2px 0;transition:.14s}
.nav-btn .icon{color:#8a93ac;transition:.14s}
.nav-btn:hover{background:#f2f4fa}
.nav-btn.active{background:var(--primary-soft);color:var(--primary2)}
.nav-btn.active .icon{color:var(--primary)}

/* ---------- content / cards ---------- */
.content{padding:30px 30px 60px;min-width:0}.page{display:none}.page.active{display:block;animation:fadein .18s ease}
@keyframes fadein{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
.page-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:24px}
.page-intro h2{font-size:24px;margin:0 0 4px;letter-spacing:-.5px;font-weight:750}
.page-intro p{margin:0;color:var(--muted);font-size:13px}
.grid-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat{background:#fff;border:1px solid var(--border);border-radius:14px;padding:17px 18px;box-shadow:var(--shadow-sm);display:flex;gap:13px;align-items:center}
.stat-icon{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;flex-shrink:0}
.stat-icon.b1{background:var(--info-soft);color:var(--info)}
.stat-icon.b2{background:var(--success-soft);color:var(--success)}
.stat-icon.b3{background:#f3ecff;color:#7c3aed}
.stat-icon.b4{background:var(--danger-soft);color:var(--danger)}
.stat-label{font-size:11px;color:var(--muted);font-weight:600}
.stat-value{font-size:22px;font-weight:780;margin-top:2px;letter-spacing:-.4px}
.card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow-sm);margin-bottom:18px}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}
.section-title{display:flex;align-items:center;gap:11px}
.section-icon{width:36px;height:36px;border-radius:10px;background:var(--surface2);display:grid;place-items:center;color:var(--primary);flex-shrink:0}
.section-title h3{margin:0;font-size:16px;font-weight:700}
.section-title p{margin:3px 0 0;color:var(--muted);font-size:12px}

/* ---------- buttons ---------- */
.btn{height:37px;border:1px solid transparent;border-radius:9px;padding:0 13px;background:#f1f3f8;color:#3a4360;font-weight:650;font-size:12.5px;transition:.14s;display:inline-flex;align-items:center;gap:7px}
.btn:hover{filter:brightness(.97)}
.btn:active{transform:translateY(1px)}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 1px 2px rgba(53,86,217,.25)}.btn-primary:hover{background:var(--primary2)}
.btn-success{background:var(--success-soft);color:var(--success);border-color:#c6ecd8}
.btn-danger{background:var(--danger-soft);color:var(--danger);border-color:#f5cfd0}
.btn-ghost{background:#fff;border-color:var(--border)}
.btn-sm{height:33px;padding:0 10px;font-size:11.5px}

/* ---------- forms ---------- */
.form-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font-size:11px;font-weight:700;color:#4b5573}
.field input,.field select,.modal-box input,.modal-box select{height:41px;width:100%;padding:0 12px;border:1px solid #cdd3e0;border-radius:9px;background:#fff;color:var(--text);outline:none;transition:.14s}
.field input:focus,.field select:focus,.modal-box input:focus,.modal-box select:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(53,86,217,.12)}
.span-2{grid-column:span 2}.span-3{grid-column:span 3}.span-4{grid-column:span 4}.span-6{grid-column:span 6}.span-12{grid-column:span 12}
.step-badge{width:26px;height:26px;border-radius:8px;background:var(--primary-soft);color:var(--primary2);font-size:12px;font-weight:800;display:grid;place-items:center}

/* ---------- table ---------- */
.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:12px}
.data-table{width:100%;border-collapse:collapse;min-width:920px}
.data-table th{background:var(--surface2);text-align:left;padding:11px 13px;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#6b7590;font-weight:750;border-bottom:1px solid var(--border)}
.data-table td{padding:13px;border-bottom:1px solid var(--border);font-size:12.5px;vertical-align:middle}
.data-table tr:last-child td{border-bottom:0}
.data-table tr:hover td{background:#fafbfe}
.device-name{font-weight:750;font-size:13px;display:flex;align-items:center;gap:8px}
.vendor-chip{width:26px;height:26px;border-radius:7px;display:grid;place-items:center;font-size:10px;font-weight:800;flex-shrink:0;color:#fff}
.vendor-chip.huawei{background:#c2373a}.vendor-chip.juniper{background:#0f8a5f}.vendor-chip.arista{background:#3556d9}
.meta{font-size:11px;color:var(--muted);margin-top:3px}
.actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}
.icon-btn{width:33px;height:33px;padding:0;justify-content:center}
.badge{display:inline-flex;align-items:center;gap:4px;border-radius:999px;padding:4px 9px;font-size:9.5px;font-weight:800;letter-spacing:.03em}
.badge .icon{width:11px;height:11px}
.badge.success{background:var(--success-soft);color:var(--success)}
.badge.warning{background:var(--warning-soft);color:var(--warning)}
.badge.danger{background:var(--danger-soft);color:var(--danger)}
.badge.info{background:var(--info-soft);color:var(--info)}
.empty{padding:32px;text-align:center;color:var(--muted);font-size:13px;display:flex;flex-direction:column;align-items:center;gap:10px}
.empty .icon{width:26px;height:26px;color:#c2c8db}
.message{min-height:18px;margin:10px 0 0;font-size:12px;font-weight:600}.message.success{color:var(--success)}.message.error{color:var(--danger)}

/* ---------- login ---------- */
.login-screen{min-height:100vh;background:
  radial-gradient(circle at 15% 0%,rgba(53,86,217,.10) 0,transparent 45%),
  radial-gradient(circle at 100% 100%,rgba(53,86,217,.07) 0,transparent 40%),
  var(--bg);
  display:flex;align-items:center;justify-content:center;padding:24px}
.login-panel{width:min(420px,100%);background:#fff;border:1px solid var(--border);border-radius:20px;box-shadow:0 30px 70px rgba(16,23,40,.14);padding:36px}
.login-brand{text-align:center;margin-bottom:26px}
.login-brand .brand-mark{margin:0 auto 16px;width:52px;height:52px;border-radius:14px}
.login-brand .brand-mark svg{width:26px;height:26px}
.login-brand h1{font-size:20px;margin:0 0 5px;font-weight:750;letter-spacing:-.3px}
.login-brand p{font-size:12.5px;color:var(--muted);margin:0}
.login-fields{display:grid;gap:14px}
.login-field label{display:block;font-size:11px;font-weight:700;color:#4b5573;margin-bottom:6px}
.login-field .input-wrap{position:relative}
.login-field .input-wrap .icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#9aa3ba}
.login-field input{height:44px;width:100%;border:1px solid #cdd3e0;border-radius:10px;padding:0 13px 0 38px;outline:none;transition:.14s}
.login-field input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(53,86,217,.12)}
.login-submit{width:100%;height:44px;margin-top:4px;justify-content:center;font-size:13px}
.login-note{text-align:center;color:#a3abc2;font-size:10.5px;margin-top:22px;display:flex;align-items:center;justify-content:center;gap:6px}

/* ---------- toolbar / search ---------- */
.toolbar{display:flex;gap:8px;align-items:center}
.search-wrap{position:relative}
.search-wrap .icon{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#9aa3ba}
.search{height:37px;width:260px;border:1px solid #cdd3e0;border-radius:9px;padding:0 11px 0 33px;outline:none}
.search:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(53,86,217,.12)}

/* ---------- backups / schedules lists ---------- */
.backup-list,.schedule-list{border:1px solid var(--border);border-radius:12px;overflow:hidden}
.backup-row,.schedule-row{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:15px}
.backup-row:last-child,.schedule-row:last-child{border-bottom:0}
.backup-row:hover,.schedule-row:hover{background:#fafbfe}
.backup-title{font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.backup-meta{font-size:11px;color:var(--muted);margin-top:4px;display:flex;align-items:center;gap:5px}
.backup-path{font:10px ui-monospace,monospace;color:#8791ab;margin-top:4px;word-break:break-all}
.error-text{font-size:11px;color:var(--danger);margin-top:4px}

/* ---------- diff ---------- */
.diff-controls{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:9px}
.diff-controls select{height:40px;border:1px solid #cdd3e0;border-radius:9px;padding:0 10px;background:#fff}
.diff-box{margin-top:14px;border:1px solid #202a45;border-radius:12px;background:var(--dark);color:#cfe0ff;min-height:180px;max-height:560px;overflow:auto;font:12px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace}
.diff-line{padding:2px 12px;white-space:pre-wrap}
.diff-line.add{background:rgba(47,208,127,.14);color:#a7f3c8}
.diff-line.del{background:rgba(220,80,80,.16);color:#fecdd1}
.diff-line.hunk{background:rgba(53,86,217,.22);color:#bcd0ff}

/* ---------- modals ---------- */
.modal{position:fixed;inset:0;background:rgba(8,12,26,.62);backdrop-filter:blur(1px);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px}
.modal-box{background:#fff;border-radius:18px;border:1px solid var(--border);padding:24px;width:min(760px,96vw);max-height:90vh;overflow:auto;box-shadow:0 30px 90px rgba(0,0,0,.32)}
.modal-box.wide{width:min(1200px,96vw)}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:19px}
.modal-head h3{margin:0;font-size:18px;font-weight:750;display:flex;align-items:center;gap:9px}
.close{width:32px;height:32px;border:0;border-radius:9px;background:var(--surface2);color:#4b5573;display:grid;place-items:center}
.close:hover{background:#eceff5}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.modal-box label{font-size:11px;color:#4b5573;font-weight:650}
.modal-box label input,.modal-box label select{margin-top:6px}
.check{display:flex!important;align-items:center;gap:8px;margin:13px 0;font-size:12.5px}
.check input{width:auto!important;height:auto!important}
.config-viewer{background:var(--dark);color:#cfe0ff;padding:18px;border-radius:12px;overflow:auto;max-height:72vh;white-space:pre-wrap;word-break:break-word;font:12px/1.6 ui-monospace,monospace}

/* ---------- toasts ---------- */
.toast-wrap{position:fixed;right:20px;bottom:20px;z-index:200;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--dark2);color:#fff;border-radius:10px;padding:12px 15px;box-shadow:0 12px 30px rgba(0,0,0,.25);font-size:12.5px;max-width:380px;border-left:3px solid var(--success);display:flex;align-items:center;gap:9px;animation:slidein .18s ease}
.toast.err{border-left-color:var(--danger)}
@keyframes slidein{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:none}}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:2px}
.btn .spinner{border-color:#cbd5e1;border-top-color:var(--primary)}
@keyframes spin{to{transform:rotate(360deg)}}

@media(max-width:1000px){.shell{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid var(--border);display:flex;overflow:auto;padding:8px}.nav-label{display:none}.nav-btn{width:auto;white-space:nowrap}.grid-stats{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:repeat(6,1fr)}.span-2,.span-3,.span-4{grid-column:span 3}}
@media(max-width:700px){.content{padding:18px 12px 40px}.header-inner{padding:0 14px}.brand small,.user-pill span{display:none}.grid-stats{grid-template-columns:1fr 1fr}.form-grid{display:block}.field{margin-bottom:11px}.page-intro{display:block}.page-intro h2{font-size:21px}.toolbar{flex-wrap:wrap}.search-wrap{width:100%}.search{width:100%}.diff-controls{display:block}.diff-controls>*{width:100%;margin-bottom:8px}.modal-grid{grid-template-columns:1fr}.login-panel{padding:26px 21px}}
</style>
</head>
<body>

<!-- ============ ICON SPRITE (inline defs, reused via <use>) ============ -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<defs>
<symbol id="ic-network" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.4"/><circle cx="5" cy="19" r="2.4"/><circle cx="19" cy="19" r="2.4"/><path d="M12 7.4v4M12 11.4 6.6 17M12 11.4 17.4 17"/></symbol>
<symbol id="ic-grid" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.4"/></symbol>
<symbol id="ic-server" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="6.5" rx="1.6"/><rect x="3.5" y="13.5" width="17" height="6.5" rx="1.6"/><circle cx="7.2" cy="6.75" r=".9" fill="currentColor" stroke="none"/><circle cx="7.2" cy="16.75" r=".9" fill="currentColor" stroke="none"/></symbol>
<symbol id="ic-plus-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 8.3v7.4M8.3 12h7.4"/></symbol>
<symbol id="ic-archive" viewBox="0 0 24 24"><rect x="3.3" y="4" width="17.4" height="4.6" rx="1.2"/><path d="M4.6 8.6v9.2a1.6 1.6 0 0 0 1.6 1.6h11.6a1.6 1.6 0 0 0 1.6-1.6V8.6"/><path d="M9.8 12.6h4.4"/></symbol>
<symbol id="ic-compare" viewBox="0 0 24 24"><path d="M8 4.5v14M8 4.5 4.7 7.8M8 18.5l-3.3-3.3"/><path d="M16 19.5v-14M16 19.5l3.3-3.3M16 5.5l3.3 3.3"/></symbol>
<symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.3V12l3.3 2"/></symbol>
<symbol id="ic-refresh" viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4.5v4h-4"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 19.5v-4h4"/></symbol>
<symbol id="ic-logout" viewBox="0 0 24 24"><path d="M9 4.5H6.2A1.7 1.7 0 0 0 4.5 6.2v11.6A1.7 1.7 0 0 0 6.2 19.5H9"/><path d="M14.5 16 19 12l-4.5-4"/><path d="M19 12H9"/></symbol>
<symbol id="ic-user" viewBox="0 0 24 24"><path d="M4.5 19c1-3.3 3.8-5 7.5-5s6.5 1.7 7.5 5"/><circle cx="12" cy="7.3" r="3.2"/></symbol>
<symbol id="ic-lock" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="9" rx="2"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/></symbol>
<symbol id="ic-check" viewBox="0 0 24 24"><path d="M4.5 12.5 9.5 17.5 19.5 6.5"/></symbol>
<symbol id="ic-alert" viewBox="0 0 24 24"><path d="M12 4 21 19H3Z"/><path d="M12 10v3.6"/><circle cx="12" cy="16.4" r=".2" fill="currentColor" stroke="none"/></symbol>
<symbol id="ic-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m19.5 19.5-4-4"/></symbol>
<symbol id="ic-edit" viewBox="0 0 24 24"><path d="M4.5 19.5h4l10-10-4-4-10 10Z"/><path d="M13 6.5l4 4"/></symbol>
<symbol id="ic-plug" viewBox="0 0 24 24"><path d="M9 4v5M15 4v5"/><path d="M6.5 9h11v3a5.5 5.5 0 0 1-5.5 5.5A5.5 5.5 0 0 1 6.5 12Z"/><path d="M12 17.5V20"/></symbol>
<symbol id="ic-cloud-up" viewBox="0 0 24 24"><path d="M7.5 17.5A4 4 0 0 1 8 9.6a5.5 5.5 0 0 1 10.7 1.8A3.8 3.8 0 0 1 18 17.5H7.5Z"/><path d="M12 15V9.5M9.6 11.6 12 9.2l2.4 2.4"/></symbol>
<symbol id="ic-trash" viewBox="0 0 24 24"><path d="M5 7h14"/><path d="M9.5 7V5.3a1.4 1.4 0 0 1 1.4-1.4h2.2a1.4 1.4 0 0 1 1.4 1.4V7"/><path d="M6.8 7 7.5 19a1.6 1.6 0 0 0 1.6 1.5h5.8a1.6 1.6 0 0 0 1.6-1.5L17.2 7"/><path d="M10.2 11v6M13.8 11v6"/></symbol>
<symbol id="ic-download" viewBox="0 0 24 24"><path d="M12 4v11.5M8 12l4 4 4-4"/><path d="M5 18.5h14"/></symbol>
<symbol id="ic-eye" viewBox="0 0 24 24"><path d="M3 12s3.5-6.5 9-6.5S21 12 21 12s-3.5 6.5-9 6.5S3 12 3 12Z"/><circle cx="12" cy="12" r="2.6"/></symbol>
<symbol id="ic-inbox-empty" viewBox="0 0 24 24"><path d="M4 13.5 6.3 5.8A1.6 1.6 0 0 1 7.8 4.7h8.4a1.6 1.6 0 0 1 1.5 1.1L20 13.5"/><path d="M4 13.5h5.2a.5.5 0 0 1 .5.35l.6 1.9a.6.6 0 0 0 .57.4h2.2a.6.6 0 0 0 .57-.4l.6-1.9a.5.5 0 0 1 .5-.35H20"/><path d="M4 13.5V18a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 18v-4.5"/></symbol>
</defs>
</svg>

<div id="loginScreen" class="login-screen">
  <div class="login-panel">
    <div class="login-brand">
      <div class="brand-mark"><svg class="icon"><use href="#ic-network"/></svg></div>
      <h1>Network Config Manager</h1>
      <p>Secure Network Configuration &amp; Backup Platform</p>
    </div>
    <form id="loginForm" class="login-fields">
      <div class="login-field"><label>Username</label>
        <div class="input-wrap"><svg class="icon"><use href="#ic-user"/></svg><input id="loginUsername" autocomplete="username" placeholder="Enter username" required></div>
      </div>
      <div class="login-field"><label>Password</label>
        <div class="input-wrap"><svg class="icon"><use href="#ic-lock"/></svg><input id="loginPassword" type="password" autocomplete="current-password" placeholder="Enter password" required></div>
      </div>
      <button id="loginButton" class="btn btn-primary login-submit" type="submit">Sign in</button>
    </form>
    <p id="loginMessage" class="message"></p>
    <div class="login-note"><svg class="icon" style="width:12px;height:12px"><use href="#ic-lock"/></svg>Authorized personnel only &middot; Network Operations</div>
  </div>
</div>

<div id="appShell" class="hidden">
<header class="app-header">
  <div class="header-inner">
    <div class="brand"><div class="brand-mark"><svg class="icon"><use href="#ic-network"/></svg></div><div><h1>Network Config Manager</h1><small>Configuration Backup &amp; Operations</small></div></div>
    <div class="header-right">
      <span id="userPill" class="user-pill"><span class="user-avatar" id="userAvatar"></span><span></span></span>
      <div class="status-pill"><span class="dot online"></span>Authenticated</div>
      <button class="btn logout-btn" onclick="logout()"><svg class="icon"><use href="#ic-logout"/></svg>Logout</button>
    </div>
  </div>
</header>
<div class="shell">
  <aside class="sidebar">
    <div style="width:100%">
      <div class="nav-label">Operations</div>
      <button class="nav-btn active" data-page="dashboard" onclick="showPage('dashboard')"><svg class="icon"><use href="#ic-grid"/></svg><span>Dashboard</span></button>
      <button class="nav-btn" data-page="devices" onclick="showPage('devices')"><svg class="icon"><use href="#ic-server"/></svg><span>Devices</span></button>
      <button class="nav-btn" data-page="add-device" onclick="showPage('add-device')"><svg class="icon"><use href="#ic-plus-circle"/></svg><span>Add Device</span></button>
      <button class="nav-btn" data-page="backups" onclick="showPage('backups')"><svg class="icon"><use href="#ic-archive"/></svg><span>Backup History</span></button>
      <button class="nav-btn" data-page="diff" onclick="showPage('diff')"><svg class="icon"><use href="#ic-compare"/></svg><span>Config Diff</span></button>
      <button class="nav-btn" data-page="schedules" onclick="showPage('schedules')"><svg class="icon"><use href="#ic-clock"/></svg><span>Schedules</span></button>
    </div>
  </aside>

  <main class="content">
    <section id="page-dashboard" class="page active">
      <div class="page-intro"><div><h2>Network Operations</h2><p>Overview of registered devices, backups and scheduled jobs.</p></div><button class="btn" onclick="refreshDashboard()"><svg class="icon"><use href="#ic-refresh"/></svg>Refresh</button></div>
      <div class="grid-stats">
        <div class="stat"><div class="stat-icon b1"><svg class="icon-lg"><use href="#ic-server"/></svg></div><div><div class="stat-label">Devices</div><div id="statDevices" class="stat-value">—</div></div></div>
        <div class="stat"><div class="stat-icon b2"><svg class="icon-lg"><use href="#ic-check"/></svg></div><div><div class="stat-label">Successful Backups</div><div id="statBackups" class="stat-value">—</div></div></div>
        <div class="stat"><div class="stat-icon b3"><svg class="icon-lg"><use href="#ic-clock"/></svg></div><div><div class="stat-label">Active Schedules</div><div id="statSchedules" class="stat-value">—</div></div></div>
        <div class="stat"><div class="stat-icon b4"><svg class="icon-lg"><use href="#ic-alert"/></svg></div><div><div class="stat-label">Failed Backups</div><div id="statFailed" class="stat-value">—</div></div></div>
      </div>
      <div class="card"><div class="section-head"><div class="section-title"><div class="section-icon"><svg class="icon"><use href="#ic-server"/></svg></div><div><h3>Recent Devices</h3><p>Quick access to network devices.</p></div></div><button class="btn btn-sm" onclick="showPage('devices')">View all</button></div><div id="dashboardDevices"></div></div>
      <div class="card"><div class="section-head"><div class="section-title"><div class="section-icon"><svg class="icon"><use href="#ic-archive"/></svg></div><div><h3>Recent Backups</h3><p>Latest configuration backup activity.</p></div></div><button class="btn btn-sm" onclick="showPage('backups')">View history</button></div><div id="dashboardBackups"></div></div>
    </section>

    <section id="page-devices" class="page">
      <div class="page-intro"><div><h2>Devices</h2><p>Manage registered Huawei, Juniper and Arista devices.</p></div><button class="btn btn-primary" onclick="showPage('add-device')"><svg class="icon"><use href="#ic-plus-circle"/></svg>Add Device</button></div>
      <div class="card"><div class="section-head"><div class="section-title"><div class="section-icon"><svg class="icon"><use href="#ic-server"/></svg></div><div><h3>Device Inventory</h3><p>Connection details and operations.</p></div></div><div class="toolbar"><div class="search-wrap"><svg class="icon"><use href="#ic-search"/></svg><input id="deviceSearch" class="search" placeholder="Search hostname, IP, site..." oninput="renderDevices()"></div><button class="btn btn-sm" onclick="loadDevices()"><svg class="icon"><use href="#ic-refresh"/></svg>Refresh</button></div></div><div id="devices"></div></div>
    </section>

    <section id="page-add-device" class="page">
      <div class="page-intro"><div><h2>Add Device</h2><p>Register a network device with encrypted SSH credentials.</p></div></div>
      <div class="card">
        <div class="section-head"><div class="section-title"><div class="step-badge">1</div><div><h3>Device Information</h3><p>Identify the device and its management location.</p></div></div></div>
        <div class="form-grid">
          <div class="field span-4"><label>Hostname *</label><input id="hostname" placeholder="TSR-CORE-R01"></div>
          <div class="field span-4"><label>Management IP *</label><input id="ip" placeholder="172.19.5.50"></div>
          <div class="field span-2"><label>Vendor *</label><select id="vendor"><option value="huawei">Huawei</option><option value="juniper">Juniper</option><option value="arista">Arista</option></select></div>
          <div class="field span-2"><label>Model</label><input id="model" placeholder="S6730 / MX304"></div>
          <div class="field span-4"><label>Site / Location</label><input id="site" placeholder="TSR" value="TSR"></div>
        </div>
      </div>
      <div class="card">
        <div class="section-head"><div class="section-title"><div class="step-badge">2</div><div><h3>SSH Connection</h3><p>Credentials are encrypted before storage.</p></div></div></div>
        <div class="form-grid">
          <div class="field span-4"><label>SSH Username *</label><input id="duser" placeholder="Username"></div>
          <div class="field span-4"><label>SSH Password *</label><input id="dpass" type="password" placeholder="Password"></div>
          <div class="field span-2"><label>SSH Port</label><input id="sshport" type="number" min="1" max="65535" value="22"></div>
          <div class="field span-2" style="justify-content:end"><label>&nbsp;</label><button class="btn btn-primary" onclick="addDevice()"><svg class="icon"><use href="#ic-plus-circle"/></svg>Add Device</button></div>
        </div>
        <p id="addResult" class="message"></p>
      </div>
    </section>

    <section id="page-backups" class="page">
      <div class="page-intro"><div><h2>Backup History</h2><p>Configuration versions stored by device and timestamp.</p></div><button class="btn" onclick="loadBackups()"><svg class="icon"><use href="#ic-refresh"/></svg>Refresh</button></div>
      <div class="card"><div id="backups"></div></div>
    </section>

    <section id="page-diff" class="page">
      <div class="page-intro"><div><h2>Config Diff</h2><p>Compare two successful backups from the same device.</p></div></div>
      <div class="card">
        <div class="diff-controls">
          <select id="diffDevice" onchange="loadDiffOptions()"><option value="">Select device</option></select>
          <select id="diffA"><option value="">Older backup</option></select>
          <select id="diffB"><option value="">Newer backup</option></select>
          <button class="btn btn-primary" onclick="runDiff()"><svg class="icon"><use href="#ic-compare"/></svg>Compare</button>
        </div>
        <div id="diffResult" class="diff-box"><div class="empty" style="color:#8b96b8"><svg class="icon"><use href="#ic-compare"/></svg>Select a device and two successful backups.</div></div>
      </div>
    </section>

    <section id="page-schedules" class="page">
      <div class="page-intro"><div><h2>Backup Schedules</h2><p>Configure automatic backup intervals, retries and retention.</p></div><button class="btn" onclick="loadSchedules()"><svg class="icon"><use href="#ic-refresh"/></svg>Refresh</button></div>
      <div class="card"><div id="schedules"></div></div>
    </section>
  </main>
</div>
</div>

<div id="editModal" class="modal hidden"><div class="modal-box">
  <div class="modal-head"><h3><svg class="icon icon-lg"><use href="#ic-edit"/></svg>Edit Device</h3><button class="close" onclick="closeEdit()">×</button></div>
  <div class="modal-grid">
    <label>Hostname<input id="e_hostname"></label><label>Management IP<input id="e_ip"></label>
    <label>Vendor<select id="e_vendor"><option value="huawei">Huawei</option><option value="juniper">Juniper</option><option value="arista">Arista</option></select></label>
    <label>Model<input id="e_model"></label><label>SSH Username<input id="e_user"></label><label>SSH Port<input id="e_port" type="number" min="1" max="65535"></label>
    <label>New SSH Password<input id="e_pass" type="password" placeholder="Leave blank to keep"></label><label>Site<input id="e_site"></label>
  </div>
  <label class="check"><input id="e_enabled" type="checkbox"> Device enabled</label>
  <div class="actions"><button class="btn btn-primary" onclick="saveEdit()"><svg class="icon"><use href="#ic-check"/></svg>Save Changes</button><button class="btn" onclick="closeEdit()">Cancel</button></div><p id="editResult" class="message"></p>
</div></div>

<div id="viewerModal" class="modal hidden"><div class="modal-box wide"><div class="modal-head"><h3 id="viewerTitle"><svg class="icon icon-lg"><use href="#ic-eye"/></svg>Backup Viewer</h3><button class="close" onclick="closeViewer()">×</button></div><pre id="viewerContent" class="config-viewer"></pre></div></div>

<div id="scheduleModal" class="modal hidden"><div class="modal-box">
  <div class="modal-head"><h3><svg class="icon icon-lg"><use href="#ic-clock"/></svg>Backup Schedule</h3><button class="close" onclick="closeSchedule()">×</button></div>
  <p id="scheduleDeviceName" class="meta"></p>
  <label class="check"><input id="s_enabled" type="checkbox"> Enable automatic backup</label>
  <div class="modal-grid">
    <label>Interval<select id="s_interval"><option value="15">Every 15 minutes</option><option value="30">Every 30 minutes</option><option value="60">Every 1 hour</option><option value="360">Every 6 hours</option><option value="720">Every 12 hours</option><option value="1440">Daily</option><option value="10080">Weekly</option></select></label>
    <label>Custom interval (minutes)<input id="s_custom" type="number" min="15" max="525600" placeholder="Optional"></label>
    <label>Retry count<input id="s_retry" type="number" min="0" max="10" value="2"></label>
    <label>Retry delay (seconds)<input id="s_delay" type="number" min="0" max="3600" value="30"></label>
    <label>Keep successful backups<input id="s_retention" type="number" min="1" max="10000" value="30"></label>
  </div>
  <div class="actions" style="margin-top:16px"><button class="btn btn-primary" onclick="saveSchedule()"><svg class="icon"><use href="#ic-check"/></svg>Save Schedule</button><button class="btn btn-danger" onclick="deleteSchedule()"><svg class="icon"><use href="#ic-trash"/></svg>Remove Schedule</button></div><p id="scheduleResult" class="message"></p>
</div></div>

<div id="toastWrap" class="toast-wrap"></div>

<script>
let token="", currentUser=null, editingId=null, scheduleDeviceId=null;
let cachedDevices=[], cachedBackups=[], cachedSchedules=[];
const $=id=>document.getElementById(id);

function toast(msg,type="ok"){
  const e=document.createElement("div"); e.className="toast"+(type==="err"?" err":"");
  e.innerHTML=`<svg class="icon" style="color:${type==="err"?"#ff8f90":"#5fe3a3"}"><use href="#${type==="err"?"ic-alert":"ic-check"}"/></svg><span>${esc(msg)}</span>`;
  $("toastWrap").appendChild(e); setTimeout(()=>e.remove(),3500);
}
function setMsg(id,msg,type=""){const e=$(id); if(!e)return; e.textContent=msg; e.className="message "+type}
function esc(v){return String(v??"").replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]))}
function jsq(v){return String(v).replace(/\\/g,"\\\\").replace(/'/g,"\\'")}
function formatDate(v){return v?new Date(v).toLocaleString():"—"}
function vendorIcon(v){return v==="huawei"?"H":v==="juniper"?"J":v==="arista"?"A":"N"}
function intervalText(m){if(m%10080===0)return `${m/10080} week(s)`;if(m%1440===0)return `${m/1440} day(s)`;if(m%60===0)return `${m/60} hour(s)`;return `${m} min`}
function deviceName(id){const x=cachedDevices.find(v=>v.id===id);return x?x.hostname:`Device ${id}`}

function showApp(){
  $("loginScreen").classList.add("hidden"); $("appShell").classList.remove("hidden");
  $("userPill").querySelector("span:last-child").textContent=`${currentUser.username} • ${currentUser.role}`;
  $("userAvatar").textContent=(currentUser.username||"?").slice(0,2).toUpperCase();
}
function showLogin(){
  $("appShell").classList.add("hidden"); $("loginScreen").classList.remove("hidden");
  $("loginPassword").value="";
}
function showPage(name){
  document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));
  const page=$("page-"+name); if(page)page.classList.add("active");
  document.querySelectorAll(".nav-btn").forEach(x=>x.classList.toggle("active",x.dataset.page===name));
  if(name==="devices")loadDevices();
  if(name==="backups")loadBackups();
  if(name==="diff")loadDiffDevices();
  if(name==="schedules")loadSchedules();
}
function handle401(){
  localStorage.removeItem("ncm_token"); token=""; currentUser=null; cachedDevices=[]; cachedBackups=[]; cachedSchedules=[];
  showLogin(); setMsg("loginMessage","Your session has expired. Please sign in again.","error");
}
async function api(url,options={}){
  if(!token){handle401(); throw new Error("Not authenticated")}
  const headers={...(options.headers||{}),Authorization:"Bearer "+token};
  if(options.body && !headers["Content-Type"])headers["Content-Type"]="application/json";
  const r=await fetch(url,{...options,headers});
  if(r.status===401){handle401();throw new Error("Unauthorized")}
  return r;
}
async function validateSession(){
  const saved=localStorage.getItem("ncm_token");
  if(!saved){showLogin();return false}
  token=saved;
  try{
    const r=await api("/api/auth/me");
    if(!r.ok)throw new Error("Session invalid");
    currentUser=await r.json(); showApp(); await loadAll(); return true;
  }catch(e){handle401();return false}
}
async function login(){
  const button=$("loginButton"); button.disabled=true; button.innerHTML='<span class="spinner"></span>Signing in...'; setMsg("loginMessage","");
  try{
    const r=await fetch("/api/auth/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username:$("loginUsername").value.trim(),password:$("loginPassword").value})});
    const d=await r.json();
    if(!r.ok){setMsg("loginMessage",d.detail||"Invalid username or password","error");return}
    token=d.access_token; localStorage.setItem("ncm_token",token);
    const me=await fetch("/api/auth/me",{headers:{Authorization:"Bearer "+token}});
    if(!me.ok)throw new Error("Could not validate session");
    currentUser=await me.json(); showApp(); toast("Login successful"); await loadAll(); showPage("dashboard");
  }catch(e){localStorage.removeItem("ncm_token");token="";setMsg("loginMessage","Unable to connect to the server.","error")}
  finally{button.disabled=false;button.textContent="Sign in"}
}
function logout(){
  localStorage.removeItem("ncm_token"); token=""; currentUser=null; cachedDevices=[]; cachedBackups=[]; cachedSchedules=[];
  showLogin(); setMsg("loginMessage","You have been logged out.","success");
}
$("loginForm").addEventListener("submit",e=>{e.preventDefault();login()});

async function loadAll(){await Promise.all([loadDevices(),loadBackups(),loadSchedules()]);await loadDiffDevices();renderDashboard()}
async function refreshDashboard(){toast("Refreshing...");await loadAll();toast("Dashboard refreshed")}

function renderDashboard(){
  $("statDevices").textContent=cachedDevices.length;
  const ok=cachedBackups.filter(x=>x.status==="SUCCESS").length, fail=cachedBackups.filter(x=>x.status==="FAILED").length;
  $("statBackups").textContent=ok; $("statFailed").textContent=fail;
  $("statSchedules").textContent=cachedSchedules.filter(x=>x.enabled).length;
  const recent=cachedDevices.slice(0,5);
  $("dashboardDevices").innerHTML=recent.length?`<div class="table-wrap"><table class="data-table"><thead><tr><th>Device</th><th>Vendor</th><th>Management</th><th>Site</th><th>Status</th></tr></thead><tbody>${recent.map(x=>`<tr><td><div class="device-name"><span class="vendor-chip ${esc(x.vendor)}">${vendorIcon(x.vendor)}</span>${esc(x.hostname)}</div><div class="meta">${esc(x.model||"No model")}</div></td><td>${esc(x.vendor)}</td><td>${esc(x.management_ip)}:${x.ssh_port}</td><td>${esc(x.site||"—")}</td><td><span class="badge ${x.enabled?"success":"warning"}">${x.enabled?"ENABLED":"DISABLED"}</span></td></tr>`).join("")}</tbody></table></div>`:'<div class="empty"><svg class="icon"><use href="#ic-inbox-empty"/></svg>No devices configured.</div>';
  const rb=cachedBackups.slice(0,5);
  $("dashboardBackups").innerHTML=rb.length?`<div class="backup-list">${rb.map(x=>`<div class="backup-row"><div><div class="backup-title"><span class="badge ${x.status==="SUCCESS"?"success":"danger"}">${esc(x.status)}</span> #${x.id} • ${esc(x.hostname)}</div><div class="backup-meta"><svg class="icon" style="width:11px;height:11px"><use href="#ic-clock"/></svg>${esc(formatDate(x.created_at))}</div></div><div>${x.status==="SUCCESS"?`<button class="btn btn-sm" onclick="viewBackup(${x.id},'${jsq(x.hostname)}')"><svg class="icon"><use href="#ic-eye"/></svg>View</button>`:""}</div></div>`).join("")}</div>`:'<div class="empty"><svg class="icon"><use href="#ic-inbox-empty"/></svg>No backup history yet.</div>';
}

async function loadDevices(){
  const r=await api("/api/devices/"); const d=await r.json(); if(!r.ok){toast(d.detail||"Failed to load devices","err");return}
  cachedDevices=d; renderDevices(); renderDashboard(); 
}
function renderDevices(){
  const q=($("deviceSearch")?.value||"").toLowerCase();
  const d=cachedDevices.filter(x=>[x.hostname,x.management_ip,x.vendor,x.model,x.site].join(" ").toLowerCase().includes(q));
  if(!d.length){$("devices").innerHTML='<div class="empty"><svg class="icon"><use href="#ic-search"/></svg>No matching devices.</div>';return}
  $("devices").innerHTML=`<div class="table-wrap"><table class="data-table"><thead><tr><th>Device</th><th>Vendor / Model</th><th>Management</th><th>Site</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>${d.map(x=>`<tr>
    <td><div class="device-name"><span class="vendor-chip ${esc(x.vendor)}">${vendorIcon(x.vendor)}</span>${esc(x.hostname)}</div><div class="meta">ID #${x.id}</div></td>
    <td><div style="text-transform:capitalize">${esc(x.vendor)}</div><div class="meta">${esc(x.model||"—")}</div></td>
    <td>${esc(x.management_ip)}:${x.ssh_port}<div class="meta">${esc(x.username)}</div></td>
    <td>${esc(x.site||"—")}</td>
    <td><span class="badge ${x.enabled?"success":"warning"}">${x.enabled?"ENABLED":"DISABLED"}</span></td>
    <td><div class="actions">
      <button class="btn btn-sm icon-btn" title="Edit" onclick="editDevice(${x.id})"><svg class="icon"><use href="#ic-edit"/></svg></button>
      <button class="btn btn-sm icon-btn" title="Test SSH" onclick="testDevice(${x.id})"><svg class="icon"><use href="#ic-plug"/></svg></button>
      <button class="btn btn-sm btn-success icon-btn" title="Backup now" onclick="backupDevice(${x.id})"><svg class="icon"><use href="#ic-cloud-up"/></svg></button>
      <button class="btn btn-sm icon-btn" title="Schedule" onclick="openSchedule(${x.id},'${jsq(x.hostname)}')"><svg class="icon"><use href="#ic-clock"/></svg></button>
      <button class="btn btn-sm btn-danger icon-btn" title="Delete" onclick="deleteDevice(${x.id},'${jsq(x.hostname)}')"><svg class="icon"><use href="#ic-trash"/></svg></button>
    </div></td>
  </tr>`).join("")}</tbody></table></div>`;
}
async function addDevice(){
  const p={hostname:$("hostname").value.trim(),management_ip:$("ip").value.trim(),vendor:$("vendor").value,model:$("model").value.trim()||null,username:$("duser").value.trim(),password:$("dpass").value,ssh_port:parseInt($("sshport").value||"22",10),site:$("site").value.trim()||"DEFAULT"};
  if(!p.hostname||!p.management_ip||!p.username||!p.password){setMsg("addResult","Hostname, Management IP, SSH Username and SSH Password are required.","error");return}
  setMsg("addResult","Adding device...");
  try{const r=await api("/api/devices/",{method:"POST",body:JSON.stringify(p)}),d=await r.json();if(!r.ok){setMsg("addResult",d.detail||"Failed to add device","error");return}setMsg("addResult","Device added successfully.","success");toast("Device added");clearAdd();await loadAll();setTimeout(()=>showPage("devices"),500)}catch(e){}
}
function clearAdd(){$("hostname").value=$("ip").value=$("model").value=$("duser").value=$("dpass").value="";$("sshport").value="22";$("site").value="TSR"}

async function testDevice(id){
  toast("Testing SSH and privilege...");
  try{const r=await api(`/api/devices/${id}/test`,{method:"POST"}),d=await r.json();if(r.ok&&d.success){toast(`SSH OK • ${d.prompt||"connected"}`)}else toast(d.message||d.detail||"SSH test failed","err")}catch(e){toast("SSH test failed","err")}
}
async function backupDevice(id){
  toast("Backup started...");
  try{const r=await api(`/api/backups/${id}/run`,{method:"POST"}),d=await r.json();if(r.ok&&d.success){toast(`Backup successful • #${d.backup_id}`);await loadAll()}else toast(d.error||d.detail||"Backup failed","err");await loadBackups()}catch(e){}
}
async function deleteDevice(id,name){
  if(!confirm(`Delete ${name}? Backup files will be retained on disk.`))return;
  try{const r=await api(`/api/devices/${id}`,{method:"DELETE"}),d=await r.json();if(!r.ok){toast(d.detail||"Delete failed","err");return}toast("Device deleted");await loadAll()}catch(e){}
}
function editDevice(id){
  const x=cachedDevices.find(v=>v.id===id);if(!x)return;editingId=id;
  $("e_hostname").value=x.hostname;$("e_ip").value=x.management_ip;$("e_vendor").value=x.vendor;$("e_model").value=x.model||"";$("e_user").value=x.username;$("e_port").value=x.ssh_port;$("e_site").value=x.site||"";$("e_pass").value="";$("e_enabled").checked=x.enabled;setMsg("editResult","");$("editModal").classList.remove("hidden")
}
function closeEdit(){editingId=null;$("editModal").classList.add("hidden")}
async function saveEdit(){
  const p={hostname:$("e_hostname").value.trim(),management_ip:$("e_ip").value.trim(),vendor:$("e_vendor").value,model:$("e_model").value.trim()||null,username:$("e_user").value.trim(),ssh_port:parseInt($("e_port").value||"22",10),site:$("e_site").value.trim()||"DEFAULT",enabled:$("e_enabled").checked};
  if($("e_pass").value)p.password=$("e_pass").value;
  try{const r=await api(`/api/devices/${editingId}`,{method:"PATCH",body:JSON.stringify(p)}),d=await r.json();if(!r.ok){setMsg("editResult",d.detail||"Update failed","error");return}closeEdit();toast("Device updated");await loadAll()}catch(e){}
}

async function loadBackups(){
  const r=await api("/api/backups/?limit=200"),d=await r.json();if(!r.ok){toast(d.detail||"Failed to load backups","err");return}
  cachedBackups=d;
  $("backups").innerHTML=d.length?`<div class="backup-list">${d.map(x=>`<div class="backup-row"><div style="min-width:0"><div class="backup-title"><span class="badge ${x.status==="SUCCESS"?"success":"danger"}">${esc(x.status)}</span> #${x.id} • ${esc(x.hostname)}</div><div class="backup-meta"><svg class="icon" style="width:11px;height:11px"><use href="#ic-clock"/></svg>${esc(formatDate(x.created_at))}</div>${x.file_path?`<div class="backup-path">${esc(x.file_path)}</div>`:""}${x.error?`<div class="error-text">${esc(x.error)}</div>`:""}</div><div class="actions">${x.status==="SUCCESS"?`<button class="btn btn-sm icon-btn" title="View" onclick="viewBackup(${x.id},'${jsq(x.hostname)}')"><svg class="icon"><use href="#ic-eye"/></svg></button><button class="btn btn-sm btn-primary icon-btn" title="Download" onclick="downloadBackup(${x.id})"><svg class="icon"><use href="#ic-download"/></svg></button>`:""}</div></div>`).join("")}</div>`:'<div class="empty"><svg class="icon"><use href="#ic-inbox-empty"/></svg>No backups yet.</div>';
  renderDashboard();
}
async function viewBackup(id,name){try{const r=await api(`/api/backups/${id}/view`),text=await r.text();if(!r.ok){toast(text||"Unable to view backup","err");return}$("viewerTitle").innerHTML=`<svg class="icon icon-lg"><use href="#ic-eye"/></svg>Backup #${id} — ${esc(name)}`;$("viewerContent").textContent=text;$("viewerModal").classList.remove("hidden")}catch(e){}}
function closeViewer(){$("viewerModal").classList.add("hidden")}
async function downloadBackup(id){try{const r=await api(`/api/backups/${id}/download`);if(!r.ok){toast("Download failed","err");return}const blob=await r.blob(),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=`backup-${id}.conf`;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url)}catch(e){}}

async function loadDiffDevices(){
  const el=$("diffDevice"); if(!el)return;
  el.innerHTML='<option value="">Select device</option>'+cachedDevices.map(x=>`<option value="${x.id}">${esc(x.hostname)} (${esc(x.vendor)})</option>`).join("");
  $("diffA").innerHTML='<option value="">Older backup</option>'; $("diffB").innerHTML='<option value="">Newer backup</option>';
}
async function loadDiffOptions(){
  const id=$("diffDevice").value;if(!id){$("diffA").innerHTML='<option value="">Older backup</option>';$("diffB").innerHTML='<option value="">Newer backup</option>';return}
  const r=await api(`/api/backups/?device_id=${id}&limit=200`),d=await r.json();if(!r.ok)return;
  const ok=d.filter(x=>x.status==="SUCCESS"),opts=ok.map(x=>`<option value="${x.id}">#${x.id} — ${esc(formatDate(x.created_at))}</option>`).join("");
  $("diffA").innerHTML='<option value="">Older backup</option>'+opts;$("diffB").innerHTML='<option value="">Newer backup</option>'+opts;
}
async function runDiff(){
  if(!$("diffA").value||!$("diffB").value){toast("Select two backups","err");return}
  try{const r=await api(`/api/backups/diff?backup_a=${$("diffA").value}&backup_b=${$("diffB").value}`),d=await r.json();if(!r.ok){$("diffResult").innerHTML=`<div class="empty" style="color:#fecdd1"><svg class="icon"><use href="#ic-alert"/></svg>${esc(d.detail||"Diff failed")}</div>`;return}if(!d.changed){$("diffResult").innerHTML='<div class="empty" style="color:#8b96b8"><svg class="icon"><use href="#ic-check"/></svg>No configuration changes detected.</div>';return}$("diffResult").innerHTML=d.lines.map(line=>{const cls=line.startsWith("+")&&!line.startsWith("+++")?"add":line.startsWith("-")&&!line.startsWith("---")?"del":line.startsWith("@@")?"hunk":"";return `<div class="diff-line ${cls}">${esc(line)||" "}</div>`}).join("")}catch(e){}
}

async function loadSchedules(){
  const r=await api("/api/schedules/"),d=await r.json();if(!r.ok){toast(d.detail||"Failed to load schedules","err");return}
  cachedSchedules=d;
  $("schedules").innerHTML=d.length?`<div class="schedule-list">${d.map(x=>`<div class="schedule-row"><div><div class="backup-title">${esc(deviceName(x.device_id))} <span class="badge ${x.enabled?"success":"warning"}">${x.enabled?"ENABLED":"DISABLED"}</span></div><div class="backup-meta"><svg class="icon" style="width:11px;height:11px"><use href="#ic-clock"/></svg>Every ${esc(intervalText(x.interval_minutes))} • Keep ${x.retention_count} • Retry ${x.retry_count}×${x.next_run?" • Next: "+esc(formatDate(x.next_run)):""}</div></div><button class="btn btn-sm" onclick="openSchedule(${x.device_id},'${jsq(deviceName(x.device_id))}')"><svg class="icon"><use href="#ic-edit"/></svg>Edit</button></div>`).join("")}</div>`:'<div class="empty"><svg class="icon"><use href="#ic-inbox-empty"/></svg>No automatic backup schedules configured.</div>';
  renderDashboard();
}
async function openSchedule(id,name){
  scheduleDeviceId=id;$("scheduleDeviceName").textContent=`Device: ${name}`;setMsg("scheduleResult","");
  try{const r=await api(`/api/schedules/${id}`),d=await r.json();if(!r.ok){setMsg("scheduleResult",d.detail||"Failed","error");return}$("s_enabled").checked=!!d.enabled;$("s_interval").value=String(d.interval_minutes);$("s_custom").value="";if(!["15","30","60","360","720","1440","10080"].includes(String(d.interval_minutes)))$("s_custom").value=d.interval_minutes;$("s_retry").value=d.retry_count??2;$("s_delay").value=d.retry_delay_seconds??30;$("s_retention").value=d.retention_count??30;$("scheduleModal").classList.remove("hidden")}catch(e){}
}
function closeSchedule(){scheduleDeviceId=null;$("scheduleModal").classList.add("hidden")}
async function saveSchedule(){
  const custom=parseInt($("s_custom").value||"0",10),interval=custom>0?custom:parseInt($("s_interval").value,10);
  const p={enabled:$("s_enabled").checked,interval_minutes:interval,retry_count:parseInt($("s_retry").value||"0",10),retry_delay_seconds:parseInt($("s_delay").value||"0",10),retention_count:parseInt($("s_retention").value||"30",10)};
  try{const r=await api(`/api/schedules/${scheduleDeviceId}`,{method:"PUT",body:JSON.stringify(p)}),d=await r.json();if(!r.ok){setMsg("scheduleResult",d.detail||"Failed","error");return}setMsg("scheduleResult",d.enabled?`Saved. Next run: ${formatDate(d.next_run)}`:"Schedule disabled.","success");toast("Schedule saved");await loadSchedules()}catch(e){}
}
async function deleteSchedule(){if(!scheduleDeviceId)return;if(!confirm("Remove automatic backup schedule?"))return;try{const r=await api(`/api/schedules/${scheduleDeviceId}`,{method:"DELETE"}),d=await r.json();if(!r.ok){setMsg("scheduleResult",d.detail||"Failed","error");return}setMsg("scheduleResult","Schedule removed.","success");toast("Schedule removed");await loadSchedules()}catch(e){}}

document.addEventListener("keydown",e=>{if(e.key==="Escape"){$("editModal").classList.add("hidden");$("viewerModal").classList.add("hidden");$("scheduleModal").classList.add("hidden")}});

validateSession();
</script>
</body>
</html>
