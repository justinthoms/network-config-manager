APP_NAME=Network Config Manager
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If this is left as a placeholder or is shorter than 32 characters, NCM generates a
# random key in backend/.secret_key and uses that instead.
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DEVICE_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
DATABASE_URL=sqlite:///./ncm.db
BACKUP_ROOT=./backups
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Security ──
# Sign out a browser after this many minutes without activity (0 = never)
SESSION_IDLE_MINUTES=30
# Lock a username for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_ATTEMPTS failed sign-ins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# /docs and /redoc API pages (off by default)
ENABLE_API_DOCS=false
# Make backups, database and key files readable by the NCM user only
RESTRICT_FILE_PERMISSIONS=true
DEFAULT_ADMIN_USERNAME=admin
# Used only to create the first admin. A weak value must be changed at first sign-in.
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ── Google Drive backup (optional) ──
# URL your browser uses to open NCM (used for the OAuth redirect)
PUBLIC_BASE_URL=http://localhost:8000
# OAuth client (Web application) from Google Cloud Console.
# Leave empty to enter them from the Cloud page instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GDRIVE_ROOT_FOLDER=NCM-Backups

# ── Microsoft OneDrive backup (optional) ──
# App registration in Microsoft Entra ID with "Allow public client flows" = Yes
# and delegated Graph permissions Files.ReadWrite + offline_access.
# Sign-in uses a device code, so no redirect URI or HTTPS is needed.
# Leave empty to enter them from the Cloud page instead.
ONEDRIVE_CLIENT_ID=
# Directory (tenant) ID, or common / organizations / consumers. Empty = common.
ONEDRIVE_TENANT_ID=
ONEDRIVE_ROOT_FOLDER=NCM-Backups

# ── AI (optional) ──
# AI providers (Gemini, OpenRouter, OpenAI, Groq, Mistral, Anthropic, Ollama) are added
# from the web UI: AI review page (shared) or My profile (personal).
# A Gemini key set here is imported once as a shared provider on first start.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
